rules_version = '2';
// 這段在做什麼：Firestore 安全規則（貼到 Firebase → Firestore Database → 規則）
// 老師：用下面清單裡的 Gmail 登入，可以看、改全部學生
// 學生：沒有帳號，靠專屬連結裡的代碼，只拿得到自己那一份資料
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() in ['TEACHER_EMAIL_1', 'TEACHER_EMAIL_2'];
    }
    function studentExists(sid) { return exists(/databases/$(database)/documents/students/$(sid)); }

    // 老師共用的設定（教材連結、影片、跟讀句子）
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    match /students/{sid} {
      // 知道代碼才讀得到；只有老師能列出全部學生
      allow get: if signedIn();
      allow list, create, delete: if isTeacher();
      // 學生只能更新上線時間、練習分鐘數、回家任務進度
      allow update: if isTeacher()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastSeenAt', 'practiceMs', 'daily', 'hwProgress']));

      match /sessions/{id} {
        allow read: if signedIn();
        allow write: if isTeacher();
      }
      match /homework/{id} {
        allow read: if signedIn();
        allow write: if isTeacher();
      }
      match /practice/{id} {
        allow read: if signedIn();
        allow create, update: if signedIn() && studentExists(sid);
        allow delete: if isTeacher();
      }
      // 練習時間軸：學生只能新增，只有老師看得到
      match /logs/{id} {
        allow read: if isTeacher();
        allow create: if signedIn() && studentExists(sid);
        allow update, delete: if isTeacher();
      }
    }
  }
}
